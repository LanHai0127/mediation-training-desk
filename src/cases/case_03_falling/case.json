  "dimensions": [
    {
      "id": "dim_claim",
      "name": "诉求识别",
      "ask": "他要的是「有人认」，不是「赔钱」。你的方案落在哪一边？",
      "options": [
        {
          "id": "o_admit",
          "label": "单独把李秀英请到一边，让她自己把阳台的事说清楚，记录下来",
          "quality": 0.95,
          "satisfies": [
            "n1"
          ],
          "requires": {
            "trust": {
              "p_b": 0.55
            }
          }
        },
        {
          "id": "o_door",
          "label": "逐户敲门问询、做笔录，暂时不下结论",
          "quality": 0.55,
          "satisfies": []
        },
        {
          "id": "o_fp",
          "label": "要求对碎片做指纹鉴定",
          "quality": 0.2,
          "satisfies": [],
          "trap": true,
          "note": "陶片粗面留不住指纹；等结果要几周，雨棚还是漏。"
        }
      ]
    },
    {
      "id": "dim_bottom",
      "name": "底线命中",
      "ask": "张涛要有人负责，李秀英怕赔不起、怕儿子知道。两头都要摸到。",
      "options": [
        {
          "id": "o_pm",
          "label": "由物业先行维修，责任待查清后再定，双方都签字确认",
          "quality": 0.8,
          "satisfies": [
            "n2",
            "n6"
          ],
          "requires": {
            "trust": {
              "p_b": 0.4
            }
          }
        },
        {
          "id": "o_half",
          "label": "让李秀英先赔一半，剩下以后再说",
          "quality": 0.3,
          "satisfies": [
            "n2"
          ],
          "trap": true,
          "note": "她赔不起，回去只会躲着不见人。"
        },
        {
          "id": "o_wait",
          "label": "先不处理赔偿，等查清谁扔的再说",
          "quality": 0.35,
          "satisfies": []
        }
      ]
    },
    {
      "id": "dim_evidence",
      "name": "证据支撑",
      "ask": "手上到底有什么？没有证据时，敢不敢说「查不清」。",
      "options": [
        {
          "id": "o_scene",
          "label": "把照片、碎片、摄像头视野、目击情况如实写进记录，明确「现有证据不能认定」",
          "quality": 1.0,
          "satisfies": [
            "n4"
          ],
          "evidence": [
            "f_dent",
            "f_cam"
          ]
        },
        {
          "id": "o_blame",
          "label": "按张涛的说法，先把责任写在 402 名下",
          "quality": 0.15,
          "satisfies": [],
          "trap": true,
          "note": "证据不足就写名字，等于替他制造了一个错误结论。"
        },
        {
          "id": "o_guess",
          "label": "不写结论，口头跟张涛说「应该是楼上，你自己去找」",
          "quality": 0.25,
          "satisfies": [],
          "trap": true,
          "note": "把矛盾推回楼道，最容易出事。"
        }
      ]
    },
    {
      "id": "dim_face",
      "name": "台阶给够",
      "ask": "一个独居老人被当着邻居指着说「就是你」，她后面只会关紧门。",
      "options": [
        {
          "id": "o_private",
          "label": "不当众点她，单独说「阳台上东西搬不动，我帮你挪」，并说清不是要她一个人担",
          "quality": 1.0,
          "satisfies": [
            "n5",
            "n7"
          ],
          "requires": {
            "trust": {
              "p_b": 0.4
            }
          }
        },
        {
          "id": "o_public",
          "label": "当着张涛的面让李秀英表态「以后不放花盆」",
          "quality": 0.35,
          "satisfies": [
            "n5"
          ],
          "trap": true,
          "note": "她要的是不被指着，这一下正好指着。"
        },
        {
          "id": "o_none",
          "label": "不谈面子，直接讲法律后果",
          "quality": 0.2,
          "satisfies": []
        }
      ]
    }
  ],
