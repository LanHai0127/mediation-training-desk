{
  "id": "case_03_falling",
  "title": "掉下来的花盆",
  "meta": {
    "subtitle": "高空抛物 · 举证不能",
    "difficulty": "中等 · 2 名当事人 · 答案可能是「谈不成」",
    "playtime": "15~20 分钟",
    "brief": "晚上八点，一楼雨棚被一个花盆砸穿。没人承认，单元口的摄像头照不到楼上。张涛要求「必须有人认」，402 的李秀英说不是她。",
    "structure": "这一案的正确答案不一定是和解——查不清责任时，把路指清楚比硬凑一份协议负责"
  },
  "alarm": {
    "time": "11 月 2 日 20:05",
    "source": "110 报警 · 城西派出所（虚构）",
    "text": "报警人张某称其雨棚被楼上掉落花盆砸坏，怀疑 402 所为，对方否认，双方在楼道发生争吵。"
  },
  "partyOrder": [
    "p_a",
    "p_b"
  ],
  "parties": {
    "p_a": {
      "name": "张涛",
      "role": "报案人 · 101 住户",
      "job": "网约车司机",
      "age": 31,
      "baseline": "火气大、语速快、反复强调「必须有人负责」",
      "triggers": [
        "算了",
        "自己认倒霉",
        "证据不足",
        "你先回去"
      ],
      "hidden": "雨棚是他上个月刚换的，三千二。他真正气的是「没人当回事」，不是那三千二。",
      "needs": [
        {
          "id": "n1",
          "text": "查清是谁扔的，有人认这个事",
          "weight": 0.5,
          "hidden": false
        },
        {
          "id": "n2",
          "text": "损失有人赔，或者有人先修",
          "weight": 0.35,
          "hidden": false
        },
        {
          "id": "n4",
          "text": "不被说成小题大做、想讹人",
          "weight": 0.25,
          "hidden": true
        }
      ],
      "fallback": {
        "empathy": [
          "……我不是要讹谁，我就是咽不下这口气。",
          "你说得对，我火大是因为没人管，不是因为钱。",
          "三千二我能挣回来，我就是想有人认。"
        ],
        "firm": [
          "你别跟我讲程序，我就问谁赔。",
          "查不清？那你们是干什么的？",
          "行，那我天天往上告。"
        ],
        "calm": [
          "我也不想跟老太太吵，可我雨棚怎么办。",
          "先解决事，别的以后再说。",
          "你们说怎么办，我听一句。"
        ],
        "apology": [
          "她要是早说一句「不是我」，我也不会吼。",
          "我不要她赔，我要个说法。",
          "……行吧，我也不是不讲理。"
        ],
        "fact": [
          "碎片我都收着了，就在雨棚下面。",
          "摄像头根本照不到，我早说过。",
          "你们去看，雨棚上那个洞还在。"
        ],
        "other": [
          "……",
          "你说完了吗？",
          "那到底谁负责。"
        ]
      }
    },
    "p_b": {
      "name": "李秀英",
      "role": "被怀疑人 · 402 住户",
      "job": "退休，独居",
      "age": 68,
      "baseline": "慢、绕、反复说「我一个老太婆」，被逼急了就沉默",
      "triggers": [
        "就是你",
        "赔钱",
        "报警抓你",
        "别装了"
      ],
      "hidden": "阳台边确实少了一个花盆——上周刮风时掉下去过，她没敢说，怕赔不起，也怕儿子知道。",
      "needs": [
        {
          "id": "n5",
          "text": "不被冤枉、不被当众指着说",
          "weight": 0.4,
          "hidden": false
        },
        {
          "id": "n6",
          "text": "不要让她儿子知道、不要闹到法院",
          "weight": 0.3,
          "hidden": true
        },
        {
          "id": "n7",
          "text": "有人帮她把剩下的花盆挪走",
          "weight": 0.25,
          "hidden": true
        }
      ],
      "fallback": {
        "empathy": [
          "……我一个人住，出了事连个商量的人都没有。",
          "你别这么说，我心里慌。",
          "你要是肯听我讲完，我就说实话。"
        ],
        "firm": [
          "我没扔，你们爱怎么着怎么着。",
          "我一个老太婆，赔不起。",
          "你叫警察来抓我好了。"
        ],
        "calm": [
          "我年纪大了，阳台上的东西我搬不动。",
          "那天风大，我也不知道。",
          "……你先坐下。"
        ],
        "apology": [
          "是我没看住，我对不住人家。",
          "我不敢说，怕赔不起。",
          "你别告诉我儿子，我自己想办法。"
        ],
        "fact": [
          "阳台上是有几个花盆，我搬不动。",
          "摄像头照不到我家阳台。",
          "那天晚上风是挺大。"
        ],
        "other": [
          "……",
          "你说什么？",
          "我听着呢。"
        ]
      }
    }
  },
  "facts": [
    {
