{
  "id": "case_00_flame",
  "title": "堵住的那条道",
  "meta": {
    "subtitle": "消防通道被占 · 一通电话",
    "difficulty": "开胃 · 2 名当事人 · 不用出现场",
    "playtime": "5~8 分钟",
    "brief": "上午九点，物业打来电话：小区消防通道上横停着一辆白色轿车，车主联系上了但不肯马上下来。这一单，电话里就能办完。",
    "structure": "接警 → 电话劝导 → 限时挪车 → 回访确认。一次都不用出所"
  },
  "alarm": {
    "time": "11 月 3 日 09:05",
    "source": "电话报警 · 城西派出所（虚构）",
    "text": "辖区某小区物业来电：单元楼前的消防通道被一辆白色轿车占用，车主已联系上但称「马上就走」，已过四十分钟未挪。"
  },
  "partyOrder": [
    "p_a",
    "p_b"
  ],
  "parties": {
    "p_a": {
      "name": "王小雨",
      "role": "小区物业值班员",
      "job": "物业客服",
      "age": 26,
      "baseline": "着急、语速快、怕担责",
      "triggers": [
        "不归你们管",
        "让消防来",
        "你们自己处理"
      ],
      "hidden": "上周消防来检查过一次，整改通知还压在桌上。她怕的是这次再被拍到。",
      "needs": [
        {
          "id": "n1",
          "text": "通道今天就空出来",
          "weight": 0.5,
          "hidden": false
        },
        {
          "id": "n3",
          "text": "物业这边有个能交代的说法",
          "weight": 0.2,
          "hidden": false
        }
      ],
      "fallback": {
        "empathy": [
          "你们能管就好，我真怕消防再来一次。",
          "上周整改通知还在我桌上压着呢。",
          "我不是想为难车主，是这条路真不能堵。"
        ],
        "firm": [
          "那就直接罚他吧，我们说不听。",
          "你们不来我们也没办法。",
          "出了事算谁的？"
        ],
        "calm": [
          "行，我配合，我把车位信息发你们。",
          "我可以在群里再发一遍。",
          "他要是下来挪，我盯着。"
        ],
        "apology": [
          "我们贴过提示，但没人当回事。",
          "是我们巡查不到位。",
          "这回我把牌子立起来。"
        ],
        "fact": [
          "车横在黄线里，占了快一半。",
          "我打了两次电话，他都说马上。",
          "车主是 3 号楼的，姓刘。"
        ],
        "other": [
          "……",
          "那你们打算怎么办。",
          "我这边等着回话。"
        ]
      }
    },
    "p_b": {
      "name": "刘师傅",
      "role": "车主 · 3 号楼住户",
      "job": "网约车司机",
      "age": 41,
      "baseline": "不耐烦、觉得被针对、爱讲「就停一会儿」",
      "triggers": [
        "罚",
        "拖车",
        "曝光",
        "举报"
      ],
      "hidden": "他在等一个长途单，车一挪就抢不到；家里老人住院，这几天随时要走。",
      "needs": [
        {
          "id": "n2",
          "text": "不被罚、不被拖车",
          "weight": 0.3,
          "hidden": false
        },
        {
          "id": "n4",
          "text": "别被人当成没素质的",
          "weight": 0.2,
          "hidden": true
        }
      ],
      "fallback": {
        "empathy": [
          "……行吧，你这么说我心里也过意不去。",
          "我不是故意堵的，就停一会儿。",
          "家里老人住院，我随时要走。"
        ],
        "firm": [
          "罚就罚，我认。",
          "拖车？至于吗。",
          "我十分钟就下来，你们别催了。"
        ],
        "calm": [
          "给我十分钟，我下去挪。",
          "有车位我就停进去。",
          "你让物业给我留个位置。"
        ],
        "apology": [
          "是我不对，我马上下来。",
          "下次不停那儿了。",
          "我这就挪，别记我。"
        ],
        "fact": [
          "我就停一会儿，接个单。",
          "这条道平时也没车走。",
          "楼下根本没车位。"
        ],
        "other": [
          "……",
          "还有别的事吗。",
          "我知道了。"
        ]
      }
    }
  },
