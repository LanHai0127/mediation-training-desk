  "dimensions": [
    {
      "id": "dim_claim",
      "name": "诉求识别",
      "ask": "物业要的是「通道现在空出来」，不是「罚那个车主」。你的处置落在哪一个上？",
      "options": [
        {
          "id": "o_clear",
          "label": "先让车挪走，再让物业把禁停提示立到通道口——两件事一起办",
          "quality": 1.0,
          "satisfies": [
            "n1",
            "n3"
          ]
        },
        {
          "id": "o_fine",
          "label": "直接按占用消防通道处理，开单处罚",
          "quality": 0.2,
          "satisfies": [],
          "trap": true,
          "note": "人还没下来就先定性，车照样堵着，事也没办成。"
        },
        {
          "id": "o_notice",
          "label": "让物业在业主群里发个通知，等车主自觉",
          "quality": 0.3,
          "satisfies": [
            "n3"
          ],
          "trap": true,
          "note": "群里发过两次了，车还在那儿。"
        }
      ]
    },
    {
      "id": "dim_action",
      "name": "处置到位",
      "ask": "电话里能把事办完，靠的是「找对人 + 给个期限 + 回访确认」。",
      "options": [
        {
          "id": "o_call",
          "label": "直接打给车主，说明后果，给十分钟期限，挂电话后回访物业确认已挪",
          "quality": 1.0,
          "satisfies": [
            "n1",
            "n2",
            "n4"
          ]
        },
        {
          "id": "o_wait",
          "label": "让物业继续等，说「他答应了就行」",
          "quality": 0.15,
          "satisfies": [],
          "trap": true,
          "note": "「马上就走」已经说了四十分钟。"
        },
        {
          "id": "o_fire",
          "label": "直接转消防救援机构，让专业部门来处置",
          "quality": 0.4,
          "satisfies": [
            "n1"
          ],
          "trap": true,
          "note": "通道真堵死了该转；这里还剩两米，先自己办更快。"
        }
      ]
    }
  ],
  "endings": {
    "reached": {
      "label": "电话办结",
      "text": "十分钟内车挪走了，物业立了提示牌，不需要出现场。"
    },
    "reached_weak": {
      "label": "勉强办结",
      "text": "车挪了，但只是这一次；没有留下任何防止再犯的东西。"
    },
    "need_more": {
      "label": "还需要再办",
      "text": "有维度没落地，或关键事实没核实——这通电话还没打完。"
    },
    "no_separate": {
      "label": "程序不合格",
      "text": "没有分别沟通就直接施压，容易把人逼到对立面。"
    },
    "overpromised": {
      "label": "越界承诺",
      "text": "答应了做不到的事，比如「保证不处罚」。"
    },
    "early_giveup": {
      "label": "过早转办",
      "text": "电话能办的事推给消防，是把麻烦扔出去。"
    },
    "forced_agreement": {
      "label": "硬凑协议",
      "text": "电话里压服了对方，但问题没有真正解决。"
    },
    "rupture_referred": {
      "label": "依法告知并转办",
      "text": "该转消防的转消防，把路指清楚。"
    }
  },
