{
  "id": "case_06_wall",
  "title": "三十公分",
  "meta": {
    "subtitle": "院墙越界与排水 · 三方 · 五维",
    "difficulty": "高难 · 3 方当事人 · 5 个维度",
    "playtime": "25~30 分钟",
    "brief": "清早六点，李家报警：张家院墙占了她家三十公分。两家从口角到抡铁锹。村委想在汛期前修通排水沟，沟走的正是争议地界。",
    "structure": "先分别谈：李家要地界，张家要墙不动，村委要沟修通。最后找那个能让三方都下台的动作"
  },
  "alarm": {
    "time": "11 月 3 日 06:10",
    "source": "110 报警 · 城西派出所（虚构）",
    "text": "报警人李某称与邻居因院墙占地发生争执，双方持铁锹对峙，要求民警到场处置。"
  },
  "partyOrder": [
    "p_a",
    "p_b",
    "p_c"
  ],
  "parties": {
    "p_a": {
      "name": "李秀兰",
      "role": "报案人 · 东院住户",
      "job": "务农，兼做零工",
      "age": 56,
      "baseline": "语速快、委屈、反复说「三十公分」",
      "triggers": [
        "算了算了",
        "说不清",
        "老黄历",
        "你们让一让"
      ],
      "hidden": "她翻屋檐不是为了占便宜，是屋顶漏雨。真正让她急的是雨水全排进张家菜地，两家已经为这个吵了三年。",
      "needs": [
        {
          "id": "n1",
          "text": "地界有个说得清的说法",
          "weight": 0.35,
          "hidden": false
        },
        {
          "id": "n2",
          "text": "雨水别再往她家院里倒灌",
          "weight": 0.3,
          "hidden": false
        },
        {
          "id": "n4",
          "text": "不被说成爱占便宜的邻居",
          "weight": 0.25,
          "hidden": true
        }
      ],
      "fallback": {
        "empathy": [
          "……你要肯听我说完，我就不吵。",
          "我不是要占她家地方，我是屋顶漏。",
          "三十公分，你们量一量就知道了。"
        ],
        "firm": [
          "墙必须拆，占了我的地就得退。",
          "你们不管，我就往上告。",
          "别跟我讲老黄历，讲证据。"
        ],
        "calm": [
          "量就量，我不怕量。",
          "沟修好了，我就不说了。",
          "先把水引走，别的事慢慢谈。"
        ],
        "apology": [
          "……我也不想闹成这样。",
          "我早上说话冲了。",
          "她要是肯认一句，这事就过去了。"
        ],
        "fact": [
          "宅基地的本子我收着。",
          "墙根那块界石还在，只是埋进去半截。",
          "下雨你们来看，水全往我院里灌。"
        ],
        "other": [
          "……",
          "你说这话是什么意思。",
          "那到底怎么算。"
        ]
      }
    },
    "p_b": {
      "name": "张守义",
      "role": "被投诉人 · 西院住户",
      "job": "务农",
      "age": 62,
      "baseline": "慢、硬、不说软话，一急就拍桌子",
      "triggers": [
        "拆墙",
        "还地",
        "讹人",
        "三十万"
      ],
      "hidden": "墙是他父亲三十年前砌的。拆墙对他来说不是让三十公分，是承认他爸当年占了人家地。",
      "needs": [
        {
          "id": "n3",
          "text": "墙不动，或者至少不拆",
          "weight": 0.35,
          "hidden": false
        },
        {
          "id": "n5",
          "text": "不被人说成「老张家占人家地」",
          "weight": 0.3,
          "hidden": true
        },
        {
          "id": "n6",
          "text": "别结仇，以后还要一起浇地",
          "weight": 0.2,
          "hidden": true
        }
      ],
      "fallback": {
        "empathy": [
          "……你这么说，我心里也过意不去。",
          "墙是我爸砌的，我不能说拆就拆。",
          "我不是不讲理，我得对得起老的。"
        ],
        "firm": [
          "拆墙？除非我死了。",
          "三十年前就定下的事，现在翻？",
          "你们爱怎么判怎么判。"
        ],
        "calm": [
          "量可以，墙先别动。",
          "沟要是村里修，我出人帮忙。",
          "只要不说我占她地，怎么都行。"
        ],
        "apology": [
          "……早上我拿锹是不对。",
          "我不该吼她。",
          "这事拖这么多年，也有我的错。"
        ],
        "fact": [
          "当年我爸请人量过，村里老人都知道。",
          "界石一直在，只是土堆上去了。",
          "她翻屋檐，水全排我菜地，我也没说啥。"
        ],
        "other": [
          "……",
          "你让村里来说。",
          "我不跟你争。"
        ]
      }
    },
    "p_c": {
      "name": "周建国",
      "role": "村委会副主任",
      "job": "村干部",
      "age": 50,
      "baseline": "客气、圆场、句句留退路",
      "triggers": [
        "村里出钱",
        "你们定",
        "上报",
        "汛期"
      ],
      "hidden": "排水沟是镇里考核的项目，汛期前必须通。他不怕花钱，怕的是花了钱还被说「偏着一家」。",
      "needs": [
        {
          "id": "n7",
          "text": "排水沟在汛期前修通",
          "weight": 0.3,
          "hidden": false
        },
        {
          "id": "n8",
          "text": "村里不背偏袒的名声",
          "weight": 0.25,
          "hidden": true
        }
      ],
      "fallback": {
        "empathy": [
          "你说的我理解，村里也难。",
          "这事拖了三年，我们也有责任。",
          "修沟的事我来跑。"
        ],
        "firm": [
          "地界的事村里断不了。",
          "你们要村里出钱，得开会。",
          "再闹我就报镇里。"
        ],
        "calm": [
          "沟由村里公益金出，两家不用掏。",
          "量地界我陪你们一起去。",
          "只要不动手，怎么谈都行。"
        ],
        "apology": [
          "是我们工作没做到。",
          "早该修这条沟。",
          "我代表村里说句对不住。"
        ],
        "fact": [
          "这条沟是镇里的项目，汛期前要验收。",
          "宅基地档案在镇里存着。",
          "界石的位置跟档案是对得上的。"
        ],
        "other": [
          "……",
          "这个要开会研究。",
          "你们先别动手。"
        ]
      }
    }
  },
  "facts": [
    {
