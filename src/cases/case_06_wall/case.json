    "reached": {
      "label": "调解达成",
      "text": "界按档案说清，沟由村里修通，两家都没被按上「占地」或「讹人」。"
    },
    "reached_weak": {
      "label": "勉强达成",
      "text": "字签了，但有一方是被压着签的，往后见面不说话。"
    },
    "need_more": {
      "label": "还需要再谈",
      "text": "边界或出资没落地，现在签就是留下一个三年后再爆的雷。"
    },
    "no_separate": {
