  "dimensions": [
    {
      "id": "dim_claim",
      "name": "诉求识别",
      "ask": "她要的是「狗别叫」，还是「有人管一管」？你的方案落在哪一个上？",
      "options": [
        {
          "id": "o_night",
          "label": "把「夜里十一点半以后把狗关进里屋、关窗」写成协议第一条",
          "quality": 1.0,
          "satisfies": [
            "n1"
          ]
        },
        {
          "id": "o_away",
          "label": "要求把狗送走",
          "quality": 0.1,
          "satisfies": [],
          "trap": true,
          "note": "她从头到尾没说要狗走，她要的是安静。"
        },
        {
          "id": "o_talk",
          "label": "让养狗人当面口头保证「以后管好」，不写具体做法",
          "quality": 0.35,
          "satisfies": [
            "n2"
          ],
          "trap": true,
          "note": "听着有回应，明天照旧。"
        }
      ]
    },
    {
      "id": "dim_bottom",
      "name": "底线命中",
      "ask": "投诉人要安静，养狗人怕失去狗。两头都碰到才算成。",
      "options": [
        {
          "id": "o_both",
          "label": "夜间关里屋、白天不限制，并明确「不送走、不处罚」",
          "quality": 1.0,
          "satisfies": [
            "n1",
            "n4",
            "n5"
          ],
          "requires": {
            "trust": {
              "p_b": 0.42
            }
          }
        },
        {
          "id": "o_only_a",
          "label": "只写夜间安静要求，对「狗怎么办」不做安排",
          "quality": 0.5,
          "satisfies": [
            "n1"
          ]
        },
        {
          "id": "o_only_b",
          "label": "劝投诉人「忍一忍，年轻人不容易」",
          "quality": 0.2,
          "satisfies": [
            "n4"
          ],
          "trap": true,
          "note": "等于让她再让一次。"
        }
      ]
    },
    {
      "id": "dim_evidence",
      "name": "证据支撑",
      "ask": "「狗很吵」要变成能写进协议的事实：几点、多久、谁听见过。",
      "options": [
        {
          "id": "o_facts",
          "label": "把三段录音的时间点、物业两次台账写进事实部分",
          "quality": 1.0,
          "satisfies": [
            "n1",
            "n2"
          ],
          "evidence": [
            "f_bark",
            "f_pm"
          ]
        },
        {
          "id": "o_words",
          "label": "只写「报警人反映狗叫扰民」",
          "quality": 0.3,
          "satisfies": []
        },
        {
          "id": "o_wait",
          "label": "建议先找专业训犬师评估，出报告再谈",
          "quality": 0.4,
          "satisfies": [],
          "trap": true,
          "note": "评估要钱要时间，今晚还得叫。"
        }
      ]
    },
    {
      "id": "dim_face",
      "name": "台阶给够",
      "ask": "养狗人最怕的不是罚，是当众被说「不配养」。",
      "options": [
        {
          "id": "o_face",
          "label": "单独跟她说「你一个人跑单还养着它，不容易」，不当众提素质；也告诉投诉人「不是你多事」",
          "quality": 1.0,
          "satisfies": [
            "n3",
            "n6"
          ],
          "requires": {
            "trust": {
              "p_a": 0.45,
              "p_b": 0.4
            }
          }
        },
        {
          "id": "o_public",
          "label": "当面把《治安管理处罚法》相关条款念给养狗人听",
          "quality": 0.35,
          "satisfies": [
            "n2"
          ],
          "trap": true,
          "note": "法条是真的，但她记住的是「你当众让我下不来台」。"
        },
        {
          "id": "o_none",
          "label": "不谈面子，直接把条款念一遍让双方签字",
          "quality": 0.2,
          "satisfies": []
        }
      ]
    }
  ],
  "endings": {
    "reached": {
      "label": "调解达成",
      "text": "夜间作息写清楚了，狗能留下，投诉人也能睡。"
