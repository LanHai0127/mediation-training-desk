{
  "id": "case_02_pet",
  "title": "楼下的狗",
  "meta": {
    "subtitle": "宠物扰民 · 邻里关系",
    "difficulty": "简单 · 2 名当事人",
    "playtime": "12~18 分钟",
    "brief": "凌晨一点二十，201 报警：楼下 101 的狗整夜叫。养狗的是个外卖骑手，白天基本不在家。",
    "structure": "先分别谈（养狗人怕被投诉、投诉人怕被说事多），再面对面定可执行的作息安排"
  },
  "alarm": {
    "time": "11 月 2 日 01:22",
    "source": "110 报警 · 城西派出所（虚构）",
    "text": "报警人刘某（201）称楼下 101 饲养的犬只夜间持续吠叫，已连续三晚，无法入睡，要求民警处理。"
  },
  "partyOrder": [
    "p_a",
    "p_b"
  ],
  "parties": {
    "p_a": {
      "name": "刘桂芳",
      "role": "报案人 · 201 住户",
      "job": "退休教师",
      "age": 63,
      "baseline": "客气但坚决，说话爱举例子，一句能绕三个弯",
      "triggers": [
        "多事",
        "矫情",
        "老年人睡得少",
        "别管闲事"
      ],
      "hidden": "她不是讨厌狗。她怕自己一开口，整栋楼都说她爱告状——她在这楼住了二十六年。",
      "needs": [
        {
          "id": "n1",
          "text": "夜里十二点以后不要再有狗叫",
          "weight": 0.45,
          "hidden": false
        },
        {
          "id": "n2",
          "text": "对方真的做点什么，不是嘴上答应",
          "weight": 0.3,
          "hidden": false
        },
        {
          "id": "n3",
          "text": "不被邻居当成爱告状的人",
          "weight": 0.25,
          "hidden": true
        }
      ],
      "fallback": {
        "empathy": [
          "你能这么说，我心里好受点。我不是跟狗过不去。",
          "我教了三十年书，最怕别人说我斤斤计较。",
          "你要是天天被吵醒，你也受不了。"
        ],
        "firm": [
          "我不管规定怎么说，我就要睡觉。",
          "你别拿规定压我，我都懂。",
          "行，那你让她把狗送走。"
        ],
        "calm": [
          "我也知道年轻人不容易，可我也七十了。",
          "我不是要追究，我要的是一个安稳。",
          "先坐下说，别站着。"
        ],
        "apology": [
          "她要是肯说句抱歉，这事就过去了。",
          "我不需要赔偿，我就要安静。",
          "我从来不想闹到派出所。"
        ],
        "fact": [
          "我录了三天，每天都是那个点。",
          "你可以去问 301，他们也听见了。",
          "物业我反映过，没人管。"
        ],
        "other": [
          "……",
          "你说这话是什么意思？",
          "我就问一句，今晚能安静吗。"
        ]
      }
    },
    "p_b": {
      "name": "阿依古丽",
      "role": "被投诉人 · 101 住户",
      "job": "外卖骑手",
      "age": 27,
      "baseline": "防御性强、语速快，习惯先解释再反驳",
      "triggers": [
        "送走",
        "罚款",
        "投诉",
        "没素质"
      ],
      "hidden": "狗是捡的，养了两年。她最怕的不是罚款，是有人说她「不配养狗」——那几乎是说她这人不配在这儿住。",
      "needs": [
        {
          "id": "n4",
          "text": "狗不被送走、不被打",
          "weight": 0.4,
          "hidden": false
        },
        {
          "id": "n5",
          "text": "不要被处罚、不要留记录",
          "weight": 0.35,
          "hidden": false
        },
        {
          "id": "n6",
          "text": "不要在整栋楼面前被指责",
          "weight": 0.25,
          "hidden": true
        }
      ],
      "fallback": {
        "empathy": [
          "……它是我捡的，就剩它了。",
          "我白天跑单，它一个人在家，我有什么办法。",
          "你说得对，我确实不知道它半夜叫成那样。"
        ],
        "firm": [
          "送走？那不行。",
          "你罚吧，罚完它还是得叫。",
          "我上班都来不及，哪有空管它叫不叫。"
        ],
        "calm": [
          "那你说怎么办，我听。",
          "我下班回来都十二点了，真没精力。",
          "它一般叫一会儿就停了。"
        ],
        "apology": [
          "……那我以后把门关上试试。",
          "我明天买个笼子，行吧。",
          "我也不是不讲理的人。"
        ],
        "fact": [
          "我隔壁也没说吵。",
          "它只在我出门的时候叫。",
          "你不信你去看，它可乖了。"
        ],
        "other": [
          "……",
          "你说吧。",
          "这事儿有这么严重吗。"
        ]
      }
    }
  },
  "facts": [
    {
      "id": "f_alarm",
      "title": "110 报警记录",
      "text": "01:22 接到报警，报警人刘某（201）称楼下犬只夜间持续吠叫三晚。"
    },
    {
      "id": "f_bark",
      "title": "手机录音三段",
      "text": "三段录音分别在 00:50、01:10、01:40，每段都能听到连续犬吠，最长一段 6 分 20 秒。"
    },
    {
      "id": "f_neighbor",
      "title": "301 住户反映",
      "text": "301 住户在楼道里说「晚上确实听得到」，但不愿出面作证。"
    },
    {
      "id": "f_pm",
      "title": "物业台账",
      "text": "物业近一个月收到两次同类反映，均未回访。"
    },
    {
      "id": "f_dog",
      "title": "现场情况",
      "text": "101 门口能闻到味道，门内有抓挠声；狗被关在阳台。"
    },
    {
      "id": "f_shift",
      "title": "作息",
      "text": "阿依古丽通常 23:40 左右到家，白班 10 点出门。"
    }
  ],
