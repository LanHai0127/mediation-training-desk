  "parties": {
    "p_a": {
      "name": "小韦",
      "role": "工人代表 · 瓦工",
      "job": "建筑瓦工",
      "age": 32,
      "baseline": "急、直、说话带火，替七个人出头，压力很大",
      "triggers": [
        "再等等",
        "走程序",
        "不归我们管",
        "你们先回去"
      ],
      "hidden": "他自己垫了两千块给两个老乡回家过年。他怕的不是自己拿不到，是老乡不信他了。",
      "needs": [
        {
          "id": "n1",
          "text": "把四万二拿到手，或者拿到能兑现的凭据",
          "weight": 0.5,
          "hidden": false
        },
        {
          "id": "n2",
          "text": "要一个明确的付款时间，不是再一次「等等」",
          "weight": 0.3,
          "hidden": false
        },
        {
          "id": "n3",
          "text": "不要在村里被说成闹事的人",
          "weight": 0.2,
          "hidden": true
        }
      ],
      "fallback": {
        "empathy": [
          "你也知道我们不容易。三个月，风里雨里。",
          "我不是想闹，我是被七个人看着。",
          "……我垫了两千，这话我没跟别人说过。"
        ],
        "firm": [
          "今天不给个说法，我们不走。",
          "你别跟我讲程序，程序能当饭吃？",
          "行，那我们上镇里。"
        ],
        "calm": [
          "我先听你说完。",
          "只要有准话，我能按住他们。",
          "分期可以，但得写纸上。"
        ],
        "apology": [
          "……你们要是早这么谈，我们也不至于堵门。",
          "我不是针对村里。",
          "有人认这个事，我就好交代。"
        ],
        "fact": [
          "工时我记着，一天没落。",
          "微信转账记录都在，去年那笔也有。",
          "我们没签合同，他口头说的工价。"
        ],
        "other": [
          "……",
          "然后呢？",
          "这话你跟我说没用。"
        ]
      }
    },
    "p_b": {
      "name": "老陈",
      "role": "包工头",
      "job": "个体包工头",
      "age": 45,
      "baseline": "疲惫、防御、反复说「我也没拿到钱」",
      "triggers": [
        "黑名单",
        "告你",
        "欠薪",
        "你就是想赖"
      ],
      "hidden": "他确实垫了材料款，卡里只剩八千。他最怕的是被列入拖欠名单——那意味着以后接不到活。",
      "needs": [
        {
          "id": "n4",
          "text": "不被列入拖欠名单、不被告",
          "weight": 0.4,
          "hidden": false
        },
        {
          "id": "n5",
          "text": "上游工程款能顺利结（最好村里出个证明）",
          "weight": 0.3,
          "hidden": false
        },
        {
          "id": "n8",
          "text": "别让工人觉得他是坏人",
          "weight": 0.2,
          "hidden": true
        }
      ],
      "fallback": {
        "empathy": [
          "……我也不想欠，我卡里就剩八千。",
          "材料款我垫了六万，谁信。",
          "你这么说，我心里好受点。"
        ],
        "firm": [
          "你告我吧，我没钱。",
          "黑名单？那以后谁还敢接活。",
          "我今天就是拿不出来。"
        ],
        "calm": [
          "分期可以，我三个月内清。",
          "村里要是肯出个结算证明，上游能给我结。",
          "我不是赖账的人。"
        ],
        "apology": [
          "是我没本事，让工人跟着受罪。",
          "这钱我认，认了就还。",
          "我对不住他们。"
        ],
        "fact": [
          "上游的结算单我带着，签了字没打款。",
          "工人的工时我都有本子。",
          "我自己垫的材料款有转账记录。"
        ],
        "other": [
          "……",
          "你说怎么办吧。",
          "我真没钱。"
        ]
      }
    },
    "p_c": {
      "name": "黄主任",
      "role": "村委会副主任",
      "job": "村干部",
      "age": 50,
      "baseline": "客气、圆滑、句句留退路，最怕担责",
      "triggers": [
        "你们村得负责",
        "先垫上",
        "上报",
        "考核"
      ],
      "hidden": "村集体账户有钱，但垫付要开会。他真正怕的是开了这个口子，以后每一笔都来找村里。",
      "needs": [
        {
          "id": "n6",
          "text": "村里不出钱、不担责",
          "weight": 0.35,
          "hidden": false
        },
        {
          "id": "n7",
          "text": "别让事闹到镇里、影响年底考核",
          "weight": 0.25,
          "hidden": true
        },
        {
          "id": "n9",
          "text": "村里在这个工程上有个说得过去的交代",
          "weight": 0.25,
          "hidden": false
        }
      ],
      "fallback": {
        "empathy": [
          "你说的我理解，可村里也有村里的难处。",
          "这事我们一直在协调。",
          "工人不容易，我知道。"
        ],
        "firm": [
          "这钱不该村里出。",
          "你们堵门是违法的。",
          "再闹我就报警了。"
        ],
        "calm": [
          "出个证明可以，走账不行。",
          "要开会研究。",
          "我们配合，但得按程序。"
        ],
        "apology": [
          "是我们协调得不够。",
          "这事拖久了，是我们的问题。",
          "我给工人道个歉。"
        ],
        "fact": [
          "工程是上面立项的，村里只是配合。",
          "集体账户的钱要开会才能动。",
          "上游的款确实还没到镇里。"
        ],
        "other": [
          "……",
          "这个我们研究一下。",
          "你让工人先回去。"
        ]
      }
    }
