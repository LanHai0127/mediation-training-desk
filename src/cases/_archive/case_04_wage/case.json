{
  "id": "case_04_wage",
  "title": "四万二的工钱",
  "meta": {
    "subtitle": "劳资欠薪 · 三方 · 依法办反而激化",
    "difficulty": "高难 · 3 方当事人 · 结构性冲突",
    "playtime": "25~30 分钟",
    "brief": "七个瓦工干了三个月，工钱四万二没结。包工头说上游没给钱，工人堵在村委会门口。村委说这钱不该村里出。",
    "structure": "三方各有底线，而且互相冲突：老陈拿不出钱、村里不愿垫、工人等不起。先分别谈，再找那个能让三方都下台的动作"
  },
  "alarm": {
    "time": "11 月 2 日 17:40",
    "source": "110 报警 · 城西派出所（虚构）",
    "text": "报警人称七名务工人员在村委会门口聚集讨要工资，情绪激动，村委要求民警到场协助处置。"
  },
  "partyOrder": [
    "p_a",
    "p_b",
    "p_c"
