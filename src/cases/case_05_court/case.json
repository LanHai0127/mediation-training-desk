      "age": 58,
      "baseline": "爽利、嗓门大、先摆资历再讲道理",
      "triggers": [
        "扰民",
        "赶走",
        "不讲理",
        "老年人"
      ],
      "hidden": "她带队六年，二十三个人跟着她。上个月体检查出问题，医生让她多活动——她怕的不是没场地，是队伍散了。",
      "needs": [
        {
          "id": "n1",
          "text": "有一个固定的时段可以跳舞",
          "weight": 0.35,
          "hidden": false
        },
        {
          "id": "n3",
          "text": "音量与结束时间有个说得过去的说法",
          "weight": 0.25,
          "hidden": false
        },
        {
          "id": "n5",
          "text": "不被当成不讲理的老人",
          "weight": 0.25,
          "hidden": true
        }
      ],
      "fallback": {
        "empathy": [
          "你能这么说，我心里舒坦点。我们不是要占着不让。",
          "我带了六年队，二十三个人跟着我，我不能说散就散。",
          "你要真替我们想，就给我们留个点。"
        ],
        "firm": [
          "这地方我们跳了六年，凭什么让？",
          "小年轻就不能去别处打？",
          "你让他们先来试试，看谁先来。"
        ],
        "calm": [
          "那你说个时间，我听。",
          "音量我可以调，人我不能赶。",
          "六点半到八点，我们一直是这样。"
        ],
        "apology": [
          "……那我把声音调小点，行吧。",
          "我也不是要跟谁置气。",
          "八点我们一定收。"
        ],
        "fact": [
          "这球场没贴过什么规定。",
          "我们队二十三个人，你问问谁不知道。",
          "上回报警也是他们先喊的。"
        ],
        "other": [
          "……",
          "你说完了吗。",
          "那到底让不让我们跳。"
        ]
      }
    },
    "p_b": {
      "name": "阿凯",
      "role": "打球青年 · 大三学生",
      "job": "在校学生",
      "age": 22,
      "baseline": "憋着火、话不多、一开口就顶",
      "triggers": [
        "让一让",
        "你们年轻人",
        "去别处",
        "不懂事"
